# Copy to backend/.env for local runs (loaded automatically by app/config.py) — NEVER commit real values.
APP_ENV=development                     # production enforces the checks in Config.validate_for_production

# ---- secrets: generate each with  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me-too          # different from JWT_SECRET: customer tokens can never open the admin API
# Fernet key for encrypting integration tokens / TOTP secrets:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- data stores
DATABASE_URL=postgresql+psycopg://crm_app:crm_app_dev@localhost:5432/crm   # must be a NON-superuser role, or RLS is bypassed
REDIS_URL=redis://localhost:6379/0

# ---- origins (CORS is not used: both apps proxy to the API, so cookies stay same-site)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
API_ORIGIN=http://localhost:5000
COOKIE_SECURE=false                     # true in production (HTTPS only)
COOKIE_DOMAIN=                          # leave empty unless apps share a parent domain on purpose

# ---- auth & admin hardening
ADMIN_REQUIRE_2FA=true
ADMIN_ALLOWED_IPS=                      # comma-separated allow-list for the Super Admin API, e.g. office/VPN egress IPs
REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- providers (each is swappable; the defaults run with zero external accounts)
BILLING_PROVIDER=mock                   # mock | stripe | razorpay   (mock is rejected in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AI_PROVIDER=mock                        # mock | anthropic | openai
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMAIL_PROVIDER=console                  # console | smtp | resend
EMAIL_FROM="CRM Wala <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
STORAGE_BACKEND=local                   # local | s3 (any S3-compatible store: AWS, R2, MinIO)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25

# ---- observability
LOG_LEVEL=INFO
LOG_FORMAT=text                         # json in production (default there)
SENTRY_DSN=

# ---- frontends (build/run time)
API_URL=http://localhost:5000           # where the Next rewrites proxy /api and /admin-api
